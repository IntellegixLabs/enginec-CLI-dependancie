--!strict
--[[
	EngineC.CodeGen
	Stage 5 of the pipeline: emits optimized Luau source text from the IR.
	The emitted code is plain Luau that calls into EngineC.Runtime -- the
	kernel-level hook layer that actually talks to the Roblox engine
	(physics, graphics, simulation loop). Stage 6 (the Runtime layer itself)
	lives in EngineC.Runtime.
]]

local IRBuilder = require(script.Parent.IRBuilder)
type IROp = IRBuilder.IROp

local CodeGen = {}

local function luaLiteral(v: any): string
	local t = type(v)
	if t == "string" then
		return string.format("%q", v)
	elseif t == "number" then
		return tostring(v)
	elseif t == "boolean" then
		return tostring(v)
	elseif t == "nil" then
		return "nil"
	else
		return "nil"
	end
end

local function argsLiteral(args: { [string]: any }): string
	local parts = {}
	-- stable-ish ordering: numeric/array keys first, then string keys sorted
	local numKeys, strKeys = {}, {}
	for k in pairs(args) do
		if type(k) == "number" then
			table.insert(numKeys, k)
		elseif k ~= "_hasChildren" then
			table.insert(strKeys, k)
		end
	end
	table.sort(numKeys)
	table.sort(strKeys)
	for _, k in ipairs(numKeys) do
		table.insert(parts, ("[%d] = %s"):format(k, luaLiteral(args[k])))
	end
	for _, k in ipairs(strKeys) do
		table.insert(parts, ("%s = %s"):format(k, luaLiteral(args[k])))
	end
	return "{ " .. table.concat(parts, ", ") .. " }"
end

local emitOp -- fwd decl

local function emitOpList(ops: { IROp }, indent: string): { string }
	local lines = {}
	for _, op in ipairs(ops) do
		for _, l in ipairs(emitOp(op, indent)) do
			table.insert(lines, l)
		end
	end
	return lines
end

function emitOp(op: IROp, indent: string): { string }
	local lines = {}
	local idLit = luaLiteral(op.id)
	local parentLit = luaLiteral(op.parent)
	local argsLit = argsLiteral(op.args)

	if op.op == "batch_create" then
		table.insert(lines, indent .. "do")
		table.insert(lines, indent .. "	local _batch = {}")
		for _, item in ipairs(op.args.items) do
			table.insert(lines, indent .. ("	table.insert(_batch, { kind = %s, id = %s, parent = %s, args = %s })")
				:format(luaLiteral(item.op), luaLiteral(item.id), luaLiteral(item.parent), argsLiteral(item.args)))
		end
		table.insert(lines, indent .. "	Runtime.batchCreate(_batch)")
		table.insert(lines, indent .. "end")
	elseif op.op == "sim_loop" then
		table.insert(lines, indent .. ("Runtime.startLoop(%s, function(dt)"):format(idLit))
		for _, sub in ipairs(op.sub or {}) do
			for _, l in ipairs(emitOp(sub, indent .. "	")) do
				table.insert(lines, l)
			end
		end
		table.insert(lines, indent .. "end)")
	elseif op.op == "engine_override" then
		table.insert(lines, indent .. ("Runtime.engineOverride(%s, {"):format(idLit))
		for _, m in ipairs(op.mods or {}) do
			table.insert(lines, indent .. ("	{ key = %s, value = %s },"):format(luaLiteral(m.key), luaLiteral(m.value)))
		end
		table.insert(lines, indent .. "})")
	else
		table.insert(lines, indent .. ("Runtime.exec(%s, %s, %s, %s)"):format(luaLiteral(op.op), idLit, parentLit, argsLit))
	end

	return lines
end

function CodeGen.generate(ops: { IROp }): string
	local out = {}
	table.insert(out, "-- Generated by EngineC Compiler -- DO NOT EDIT")
	local q = string.char(34)
	table.insert(out, "local Runtime = require(game:GetService(" .. q .. "ReplicatedStorage" .. q .. "):WaitForChild(" .. q .. "EngineC" .. q .. "):WaitForChild(" .. q .. "Runtime" .. q .. "))")
	table.insert(out, "")
	table.insert(out, "return function()")
	for _, l in ipairs(emitOpList(ops, "	")) do
		table.insert(out, l)
	end
	table.insert(out, "end")
	return table.concat(out, string.char(10))
end

-- Same codegen, but emitted as a Script's top-level body (no wrapping
-- `return function()...end`) since a real Script instance under
-- ServerScriptService executes its top-level statements automatically the
-- moment it's parented -- there's nothing to require() or call.
function CodeGen.generateScript(ops: { IROp }, label: string?): string
	local out = {}
	table.insert(out, "-- Generated by EngineC Compiler -- DO NOT EDIT")
	table.insert(out, "-- source function: " .. (label or "?"))
	local q = string.char(34)
	table.insert(out, "local Runtime = require(game:GetService(" .. q .. "ReplicatedStorage" .. q .. "):WaitForChild(" .. q .. "EngineC" .. q .. "):WaitForChild(" .. q .. "Runtime" .. q .. "))")
	table.insert(out, "")
	for _, l in ipairs(emitOpList(ops, "")) do
		table.insert(out, l)
	end
	return table.concat(out, string.char(10))
end

return CodeGen
